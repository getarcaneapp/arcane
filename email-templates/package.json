{
	"name": "arcane-email-templates",
	"version": "1.0.0",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"build": "tsx build.ts",
		"build:watch": "tsx watch build.ts",
		"check": "tsc --noEmit",
		"dev": "email dev --port 3030",
		"export": "email export",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"dependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-email": "6.9.1",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"oxfmt": "^0.62.0",
		"tsx": "^4.23.8",
		"typescript": "^7.0.2"
	}
}
