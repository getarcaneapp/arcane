		"shadcn-svelte": "^1.7.0",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"svelte-toolbelt": "^0.10.6",
		"sveltekit-superforms": "^2.30.2",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
