{
	"name": "arcane-frontend",
	"private": true,
	"version": "2.14.0",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vp dev --port 3000 --host",
		"build": "vp build",
		"preview": "vp preview --port 3000",
		"check": "svelte-kit sync && svelte-check --tsgo --incremental --tsconfig ./tsconfig.json",
		"format": "vp fmt ./src",
		"format:check": "vp fmt --check ./src",
		"check:watch": "svelte-kit sync && svelte-check --tsgo --incremental --tsconfig ./tsconfig.json --watch",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale --silent",
		"fallow": "fallow",
		"lint": "eslint src"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
