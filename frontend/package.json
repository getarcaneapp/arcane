{
	"name": "arcane-frontend",
	"private": true,
	"version": "2.8.1",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vp dev --port 3000 --host",
		"build": "vp build",
		"preview": "vp preview --port 3000",
		"check": "pnpm paraglide:compile && svelte-kit sync && svelte-check-rs --tsconfig ./tsconfig.json",
		"format": "vp fmt ./src",
		"format:check": "vp fmt --check ./src",
		"check:watch": "pnpm paraglide:compile && svelte-kit sync && svelte-check-rs --tsconfig ./tsconfig.json --watch",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale --silent",
		"fallow": "fallow"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/lang-yaml": "^6.1.3",
		"@codemirror/language": "^6.12.3",
		"@codemirror/legacy-modes": "^6.5.3",
		"@codemirror/lint": "^6.9.6",
		"@codemirror/merge": "^6.12.2",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.43.8",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/montserrat": "^5.3.0",
		"@internationalized/date": "^3.12.3",
		"@lezer/highlight": "^1.2.3",
		"@simplewebauthn/browser": "^13.3.0",
		"@sveltejs/kit": "3.0.0-next.23",
		"@tanstack/svelte-query": "^6.1.38",
		"@tanstack/svelte-table": "^9.1.2",
		"@tanstack/table-core": "9.1.2",
		"@tanstack/virtual-core": "^3.17.7",
		"@uiw/codemirror-themes": "^4.25.11",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"@xyflow/svelte": "^1.6.2",
		"ajv": "^8.20.0",
		"ansi-to-html": "^0.7.2",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"embla-carousel-svelte": "^8.6.0",
		"formsnap": "^2.0.1",
		"ky": "^2.0.2",
		"marked": "^18.0.9",
		"mode-watcher": "^1.1.0",
		"runed": "^0.37.1",
		"svelte": "^5.56.9",
		"svelte-codemirror-editor": "^2.1.0",
		"svelte-easy-crop": "^5.0.1",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"vaul-svelte": "1.0.0-next.7",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@iconify/json": "^2.2.517",
		"@inlang/paraglide-js": "2.24.1",
		"@sveltejs/adapter-static": "^4.0.0-next.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/svelte-query-devtools": "^6.1.38",
		"@types/node": "^26.2.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"fallow": "^3.17.0",
		"isomorphic-dompurify": "^3.22.0",
		"paneforge": "^1.0.2",
		"shadcn-svelte": "^1.5.0",
		"svelte-check-rs": "^0.11.0",
		"svelte-toolbelt": "^0.10.6",
		"sveltekit-superforms": "^2.30.2",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.12",
		"tw-animate-css": "^1.4.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"unplugin-icons": "^23.0.1",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	}
}
