		"@tanstack/svelte-table": "^9.2.4",
		"@tanstack/table-core": "9.2.4",
		"@tanstack/virtual-core": "^3.17.11",
		"@uiw/codemirror-themes": "^4.25.11",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"@xyflow/svelte": "^1.6.6",
		"ajv": "^8.20.0",
		"ansi-to-html": "^0.7.2",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
